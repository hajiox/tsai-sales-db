{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "sites"],
  "properties": {
    "status": { "enum": ["ready", "waiting_for_user", "needs_review", "failed"] },
    "summary": { "type": "string" },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["site", "status", "observed_name", "target_name", "product_identifier", "message"],
        "properties": {
          "site": { "enum": ["amazon", "rakuten", "yahoo", "mercari", "base", "qoo10", "tiktok"] },
          "status": { "enum": ["planned", "not_found", "blocked"] },
          "observed_name": { "type": ["string", "null"] },
          "target_name": { "type": ["string", "null"] },
          "product_identifier": { "type": ["string", "null"] },
          "message": { "type": "string" }
        }
      }
    }
  }
}
