{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "overall_analysis": { "type": "string", "maxLength": 1200 },
    "source_gaps": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "maxLength": 200 }
    },
    "suggestion": { "$ref": "#/$defs/suggestion" }
  },
  "required": ["overall_analysis", "source_gaps", "suggestion"],
  "$defs": {
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 75 },
        "selected_keywords": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 80 } },
        "rationale": { "type": "string", "maxLength": 500 },
        "cautions": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 200 } }
      },
      "required": ["name", "selected_keywords", "rationale", "cautions"]
    }
  }
}
