{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "site", "operation", "account_label", "product_identifier", "final_product_name", "final_seller_code", "final_jan_code", "final_price", "final_image_count", "final_image_urls", "description_verified", "category", "shipping_code", "tax_setting", "inventory_setting", "dispatch_setting", "origin_setting", "sale_period_setting", "public_url", "message", "summary"],
  "properties": {
    "status": { "type": "string", "enum": ["completed", "waiting_for_user", "needs_review", "failed"] },
    "site": { "type": "string", "const": "qoo10" },
    "operation": { "type": "string", "enum": ["created", "updated", "already_exists", "blocked"] },
    "account_label": { "type": ["string", "null"] },
    "product_identifier": { "type": ["string", "null"] },
    "final_product_name": { "type": ["string", "null"] },
    "final_seller_code": { "type": ["string", "null"] },
    "final_jan_code": { "type": ["string", "null"] },
    "final_price": { "type": ["integer", "null"], "minimum": 1 },
    "final_image_count": { "type": ["integer", "null"], "minimum": 0 },
    "final_image_urls": {
      "type": ["array", "null"],
      "items": { "type": "string", "minLength": 1 }
    },
    "description_verified": { "type": ["boolean", "null"] },
    "category": { "type": ["string", "null"] },
    "shipping_code": { "type": ["string", "null"] },
    "tax_setting": { "type": ["string", "null"] },
    "inventory_setting": { "type": ["string", "null"] },
    "dispatch_setting": { "type": ["string", "null"] },
    "origin_setting": { "type": ["string", "null"] },
    "sale_period_setting": { "type": ["string", "null"] },
    "public_url": { "type": ["string", "null"] },
    "message": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 }
  }
}
