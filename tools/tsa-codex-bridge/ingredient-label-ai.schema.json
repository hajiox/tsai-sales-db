{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label",
    "ingredient_statement",
    "origin_label",
    "allergen_statement",
    "allergens",
    "warnings",
    "missing_information",
    "review_notes",
    "adoption_blocked",
    "human_review_required"
  ],
  "properties": {
    "label": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "ingredient_statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "origin_label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_item_id", "target_name", "display_text"],
      "properties": {
        "target_item_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "target_name": { "type": "string", "maxLength": 300 },
        "display_text": { "type": "string", "maxLength": 300 }
      }
    },
    "allergen_statement": { "type": "string", "maxLength": 1000 },
    "allergens": {
      "type": "array",
      "maxItems": 40,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "warnings": {
      "type": "array",
      "maxItems": 40,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "missing_information": {
      "type": "array",
      "maxItems": 40,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "review_notes": {
      "type": "array",
      "maxItems": 40,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "adoption_blocked": { "type": "boolean" },
    "human_review_required": { "type": "boolean", "const": true }
  }
}
