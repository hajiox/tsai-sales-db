{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "sites"],
  "properties": {
    "status": { "enum": ["ready", "waiting_for_user", "needs_review", "failed"] },
    "summary": { "type": "string", "maxLength": 1200 },
    "sites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["site", "status", "field_layout", "marker_style", "observed_product_points", "observed_web_description", "observed_combined_content", "target_product_points", "target_web_description", "target_combined_content", "product_identifier", "message"],
        "properties": {
          "site": { "enum": ["amazon", "rakuten", "yahoo", "mercari", "base", "qoo10", "tiktok"] },
          "status": { "enum": ["planned", "not_found", "blocked"] },
          "field_layout": { "enum": ["separate", "combined"] },
          "marker_style": { "enum": ["check", "square"] },
          "observed_product_points": { "type": ["string", "null"], "maxLength": 12000 },
          "observed_web_description": { "type": ["string", "null"], "maxLength": 12000 },
          "observed_combined_content": { "type": ["string", "null"], "maxLength": 24000 },
          "target_product_points": { "type": ["string", "null"], "maxLength": 12000 },
          "target_web_description": { "type": ["string", "null"], "maxLength": 12000 },
          "target_combined_content": { "type": ["string", "null"], "maxLength": 24000 },
          "product_identifier": { "type": ["string", "null"], "maxLength": 500 },
          "message": { "type": "string", "maxLength": 1200 }
        }
      }
    }
  }
}
