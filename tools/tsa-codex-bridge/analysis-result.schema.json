{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "executive_summary",
    "sales_analysis",
    "expense_analysis",
    "floor_staff_summary",
    "actions",
    "risks",
    "data_quality"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "needs_review"]
    },
    "executive_summary": { "type": "string" },
    "sales_analysis": { "type": "string" },
    "expense_analysis": { "type": "string" },
    "floor_staff_summary": { "type": "string", "minLength": 1, "maxLength": 800 },
    "actions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "priority",
          "area",
          "title",
          "rationale",
          "evidence",
          "expected_impact",
          "deadline",
          "metric",
          "stop_condition",
          "confidence"
        ],
        "properties": {
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "area": {
            "type": "string",
            "enum": ["sales", "product", "channel", "advertising", "fees", "data"]
          },
          "title": { "type": "string" },
          "rationale": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string" }
          },
          "expected_impact": { "type": "string" },
          "deadline": { "type": "string" },
          "metric": { "type": "string" },
          "stop_condition": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "detail", "evidence"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "type": "string" }
          }
        }
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "summary", "limitations"],
      "properties": {
        "grade": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "summary": { "type": "string" },
        "limitations": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string" }
        }
      }
    }
  }
}
