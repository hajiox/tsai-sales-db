{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["overall_angle", "variation_key", "source_gaps", "writing_tone", "posts", "image_mode", "creative_overlays", "generated_images"],
  "properties": {
    "overall_angle": { "type": "string", "maxLength": 600 },
    "variation_key": { "type": "string", "maxLength": 120 },
    "source_gaps": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "maxLength": 240 }
    },
    "writing_tone": { "type": "string", "enum": ["official", "staff", "developer"] },
    "image_mode": { "type": "string", "enum": ["normal", "creative", "arrange"] },
    "posts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "instagram", "instagram_story", "threads"],
      "properties": {
        "x": { "$ref": "#/$defs/xPost" },
        "instagram": { "$ref": "#/$defs/instagramPost" },
        "instagram_story": { "$ref": "#/$defs/storyPost" },
        "threads": { "$ref": "#/$defs/threadsPost" }
      }
    },
    "creative_overlays": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "instagram", "instagram_story", "threads"],
      "properties": {
        "x": { "$ref": "#/$defs/overlay" },
        "instagram": { "$ref": "#/$defs/overlay" },
        "instagram_story": { "$ref": "#/$defs/overlay" },
        "threads": { "$ref": "#/$defs/overlay" }
      }
    },
    "generated_images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "instagram", "instagram_story", "threads"],
      "properties": {
        "x": { "$ref": "#/$defs/generatedImage" },
        "instagram": { "$ref": "#/$defs/generatedImage" },
        "instagram_story": { "$ref": "#/$defs/generatedImage" },
        "threads": { "$ref": "#/$defs/generatedImage" }
      }
    }
  },
  "$defs": {
    "xPost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "hashtags", "rationale", "link_url"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 400 },
        "hashtags": { "type": "array", "minItems": 0, "maxItems": 3, "items": { "type": "string", "maxLength": 40 } },
        "rationale": { "type": "string", "maxLength": 500 },
        "link_url": { "type": "string", "maxLength": 0 }
      }
    },
    "instagramPost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "hashtags", "rationale", "link_url"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 2200 },
        "hashtags": { "type": "array", "minItems": 10, "maxItems": 15, "items": { "type": "string", "maxLength": 40 } },
        "rationale": { "type": "string", "maxLength": 500 },
        "link_url": { "type": "string", "maxLength": 0 }
      }
    },
    "storyPost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "hashtags", "rationale", "link_url"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 50 },
        "hashtags": { "type": "array", "minItems": 0, "maxItems": 0, "items": { "type": "string" } },
        "rationale": { "type": "string", "maxLength": 500 },
        "link_url": { "type": "string", "maxLength": 2000 }
      }
    },
    "threadsPost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "hashtags", "rationale", "link_url"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "hashtags": { "type": "array", "minItems": 0, "maxItems": 5, "items": { "type": "string", "maxLength": 40 } },
        "rationale": { "type": "string", "maxLength": 500 },
        "link_url": { "type": "string", "maxLength": 0 }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "subline", "placement"],
      "properties": {
        "headline": { "type": "string", "maxLength": 48 },
        "subline": { "type": "string", "maxLength": 90 },
        "placement": { "type": "string", "enum": ["none", "top-left", "top-right", "bottom-left", "bottom-right"] }
      }
    },
    "generatedImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "file_path", "prompt_summary"],
      "properties": {
        "source": { "type": "string", "enum": ["original", "generated"] },
        "file_path": { "type": "string", "maxLength": 1000 },
        "prompt_summary": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
